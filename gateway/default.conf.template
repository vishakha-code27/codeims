server {
    listen 10000;
    server_name _;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    location = /ims {
        return 301 /;
    }

    location ^~ /ims/ {
        rewrite ^/ims/(.*)$ /$1 permanent;
    }

    location = /task2 {
        return 301 /task2/;
    }

    location /task2/ {
        proxy_pass ${TASK2_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Accept-Encoding "";
        proxy_ssl_server_name on;
        proxy_ssl_name $proxy_host;
        proxy_redirect ${TASK2_UPSTREAM}/ /task2/;
        proxy_redirect / /task2/;
        proxy_cookie_path / /task2/;
        sub_filter_types text/html;
        sub_filter_once off;
        sub_filter 'href="/' 'href="/task2/';
        sub_filter 'action="/' 'action="/task2/';
        sub_filter 'src="/' 'src="/task2/';
        sub_filter "href='/" "href='/task2/";
        sub_filter "action='/" "action='/task2/";
        sub_filter "src='/" "src='/task2/";
    }

    location / {
        proxy_pass ${IMS_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_ssl_server_name on;
        proxy_ssl_name $proxy_host;
        proxy_redirect ${IMS_UPSTREAM}/ /;
    }
}